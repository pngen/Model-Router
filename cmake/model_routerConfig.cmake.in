@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(NOT TARGET model_router::model_router)
  include("${CMAKE_CURRENT_LIST_DIR}/model_routerTargets.cmake")
endif()

set(model_router_VERSION "@PROJECT_VERSION@")
set(model_router_VERSION_MAJOR "@PROJECT_VERSION_MAJOR@")
set(model_router_VERSION_MINOR "@PROJECT_VERSION_MINOR@")
set(model_router_VERSION_PATCH "@PROJECT_VERSION_PATCH@")

check_required_components(model_router)
